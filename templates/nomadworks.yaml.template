# NomadWorks repository configuration
enabled: true
team_mode: {{teamMode}}

defaults:
  # provider: openai
  # model: gpt-5.4
  # To set sampling options, select an OpenCode model variant, e.g. openai/gpt-5.4#review.
  # permissions:
  #   - { action: shell, resource: "git push *", effect: ask }

features:
  debug_dumps: true # Dumps final agent configs to .nomadworks/generated/agents/ for verification
